# Copy to .env.local and set file permission 0600. Never paste a real key into chat.
# Groq is preferred when both keys are set; PLANNER_PROVIDER=groq|gemini pins one.
GROQ_API_KEY=
# Optional: GROQ_MODEL=openai/gpt-oss-120b  (must support strict json_schema)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.8-flash
